#!/bin/bash
#PBS -N genome_entropy_array
#PBS -q gpuvolta
#PBS -P YOUR_NCI_PROJECT
#PBS -l ngpus=1
#PBS -l ncpus=12
#PBS -l mem=90GB
#PBS -l jobfs=50GB
#PBS -l walltime=05:00:00
#PBS -l storage=gdata/YOUR_NCI_PROJECT
#PBS -l wd
#PBS -J 0-9
#PBS -j oe
#PBS -o logs/entropy_^array_index^.log
#
# Process many genomes as a PBS array, one manifest per array index.
#
# Each manifest is a text file listing GenBank paths, one per line, named
# manifests/chunk_<index>.txt with the index zero-padded to two digits.
# Set -J above to match the number of manifests; mkdir -p logs first.
#
# Sizing the chunks is the important decision, and it is a cost decision
# rather than a correctness one. Run PBS/estimate_tokens.pbs, then time a
# single-genome pipeline.pbs, before choosing. A GPU service unit on Gadi
# costs substantially more than a CPU one, so an array sized from a guess
# can consume an allocation quickly.
#
# One process per genome means the model is loaded from cache for every
# genome. On small genomes that per-invocation overhead can rival the
# encoding itself; measure it before assuming the GPU is the bottleneck.

set -euo pipefail

ENV_PREFIX="${ENV_PREFIX:-/g/data/YOUR_NCI_PROJECT/conda/genome_entropy}"
HF_CACHE="${HF_CACHE:-/g/data/YOUR_NCI_PROJECT/hf_cache}"
OUT_ROOT="${OUT_ROOT:-/g/data/YOUR_NCI_PROJECT/entropy_results}"

CHUNK_ID=$(printf "%02d" "${PBS_ARRAY_INDEX}")
MANIFEST="manifests/chunk_${CHUNK_ID}.txt"
OUT_DIR="${OUT_ROOT}/chunk_${CHUNK_ID}"

if [[ ! -f "${MANIFEST}" ]]; then
    echo "ERROR: ${MANIFEST} not found; does -J match the manifest count?" >&2
    exit 1
fi

# shellcheck disable=SC1091
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "${ENV_PREFIX}"

export GET_ORFS_PATH="${GET_ORFS_PATH:-/g/data/YOUR_NCI_PROJECT/bin/get_orfs}"
export HF_HOME="${HF_CACHE}"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TORCH_DISABLE_DYNAMO=1

mkdir -p "${OUT_DIR}"


# NCBI datasets names every GenBank file "genomic.gbff" and puts the
# accession in the parent directory:
#     .../ncbi_dataset/data/GCA_030638685.1/genomic.gbff
# Naming outputs from the basename would give every genome in a chunk the
# same output file, and the resume check below would then skip the whole
# chunk after the first genome. Derive the label from the accession
# directory instead.
genome_label () {
    local path="$1" base
    base="$(basename "${path}")"
    base="${base%.gz}"
    if [ "${base}" = "genomic.gbff" ]; then
        basename "$(dirname "${path}")"
    else
        echo "${base%.gbff}"
    fi
}

total=0
failed=0
while read -r gbff; do
    [[ -n "${gbff}" ]] || continue
    total=$((total + 1))
    base="$(genome_label "${gbff}")"
    out_json="${OUT_DIR}/${base}.json"

    # Skip completed work so a timed-out or failed index can be resubmitted
    # without repeating GPU time already paid for.
    [[ -f "${out_json}" ]] && continue

    if ! genome_entropy run -g "${gbff}" -o "${out_json}" \
            --model gbouras13/modernprost-50M --encoding-size 10000; then
        echo "FAILED: ${gbff}" >&2
        failed=$((failed + 1))
    fi
done < "${MANIFEST}"

echo "Chunk ${CHUNK_ID}: ${total} genomes, ${failed} failures."

# Exit non-zero so a partially failed index is visible in qstat -x rather
# than being mistaken for a clean run.
[[ "${failed}" -eq 0 ]]
