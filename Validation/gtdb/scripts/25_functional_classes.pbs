#!/bin/bash
#PBS -N ge_funcclass
#PBS -q normal
#PBS -P ob80
#PBS -l ncpus=2
#PBS -l mem=64GB
#PBS -l walltime=01:00:00
#PBS -l storage=gdata/ob80
#PBS -l wd
#PBS -j oe
#
#   qsub -v RANKED=<...>_candidates.tsv.gz,PREFIX=<...>/func 25_functional_classes.pbs
set -euo pipefail
cd "${PBS_O_WORKDIR}"
: "${RANKED:?Pass RANKED=<ranked candidates tsv.gz> via qsub -v}"
: "${PREFIX:?Pass PREFIX=<output prefix> via qsub -v}"
# shellcheck disable=SC1091
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "${ENV_PREFIX:-/g/data/ob80/re3494/conda/genome_entropy}"
python3 -u 25_functional_classes.py --ranked "${RANKED}" --out-prefix "${PREFIX}"
