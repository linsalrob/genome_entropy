#!/bin/bash
#PBS -N gtdb_dl
#PBS -q copyq
#PBS -P ob80
#PBS -l ncpus=1
#PBS -l mem=8GB
#PBS -l jobfs=100GB
#PBS -l walltime=10:00:00
#PBS -l storage=gdata/ob80
#PBS -l wd
#PBS -r y
#PBS -j oe
#PBS -o logs/download_^array_index^.log
#
# Fetch GenBank files from NCBI for one domain's accession chunks.
#
# copyq is the only Gadi queue with outbound internet, and it is capped at
# 1 CPU and 10 hours. That cap is fine here: downloading is I/O-bound, and
# a 250-genome chunk measured about 60 seconds.
#
# INODES ARE THE BINDING CONSTRAINT, NOT BYTES.
#
# gdata/ob80 has roughly 520k free inodes. NCBI datasets creates two inodes
# per genome -- an accession directory and a genomic.gbff inside it -- so
# 200k representative genomes would cost about 400k inodes here, and the
# entropy JSON in 04 another 200k. That is over quota before anything else
# on the project grows.
#
# So nothing per-genome is ever written to /g/data. The download is
# unpacked on node-local $PBS_JOBFS, which has its own filesystem and costs
# no /g/data inodes at all, and only a single compressed archive plus a
# manifest per chunk lands on /g/data: 2 inodes instead of ~2 x CHUNK_SIZE.
#
# THIS PBS SERVER CAPS ARRAYS AT 10 SUBJOBS (max_array_size = 10), far
# fewer than the 760 chunks bacteria needs. Each subjob therefore strides
# through the chunk list rather than handling a single chunk: subjob k
# processes chunks k, k+STRIDE, k+2*STRIDE, ... That keeps a whole domain
# in one array and pins concurrent NCBI access to exactly STRIDE streams.
# NCBI rate-limits per IP -- 3 requests/second without an API key, 10 with
# one -- so a wide fan-out gets throttled rather than finishing sooner.
#
# BEFORE SUBMITTING:
#   1. bash 01_get_gtdb_reps.sh          (login node, needs internet)
#   2. bash 01b_make_chunks.sh bac 250   (prints TOTAL_CHUNKS)
#   3. mkdir -p logs
#
# Submit as:
#   qsub -v DOMAIN=bac,TOTAL_CHUNKS=760,STRIDE=10 -r y -J 0-9 \
#        02_download_genomes.pbs
#
# Chunks whose archive already exists are skipped, so a resubmitted array
# resumes rather than re-downloading.

set -euo pipefail
cd "${PBS_O_WORKDIR}"

GDATA_ROOT="/g/data/ob80/re3494/gtdb_entropy"
ARCHIVE_DIR="${GDATA_ROOT}/genbank"
ENV_PREFIX="${ENV_PREFIX:-/g/data/ob80/re3494/conda/genome_entropy}"

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "${ENV_PREFIX}"

: "${DOMAIN:?Pass DOMAIN=bac or DOMAIN=arc via qsub -v}"
: "${TOTAL_CHUNKS:?Pass TOTAL_CHUNKS=<n> via qsub -v}"
case "${DOMAIN}" in bac|arc) ;; *) echo "DOMAIN must be bac or arc" >&2; exit 2 ;; esac
STRIDE="${STRIDE:-10}"

# An API key raises the NCBI rate limit from 3 to 10 requests/second, which
# matters for a run this size. It is kept in a mode-600 file outside the
# repository and sourced here, so the key itself never appears in a script,
# a log, or version control.
if [ -r "${HOME}/.ncbi_api_key" ]; then
    # shellcheck disable=SC1091
    source "${HOME}/.ncbi_api_key"
    echo "NCBI API key loaded (rate limit 10 req/s)."
else
    echo "No ~/.ncbi_api_key found; falling back to the 3 req/s anonymous limit."
fi

mkdir -p "${ARCHIVE_DIR}" logs

# Download and pack one chunk.
#   0 = done, 2 = already present, 1 = failed
# Returns rather than exits, so one bad chunk costs one chunk instead of
# the subjob's remaining work.
do_chunk () {
    local chunk_id="$1"
    local tag="${DOMAIN}_${chunk_id}"
    local chunk_file="${PBS_O_WORKDIR}/accessions/${tag}.txt"
    local archive="${ARCHIVE_DIR}/${tag}.tar.zst"
    local manifest="${ARCHIVE_DIR}/${tag}.manifest"
    local work="${PBS_JOBFS}/${tag}"
    local data_dir n_found n_want

    [ -f "${chunk_file}" ] || { echo "ERROR: ${chunk_file} not found." >&2; return 1; }
    if [ -f "${archive}" ]; then
        echo "Chunk ${tag}: archive already present — skipping."
        return 2
    fi

    rm -rf "${work}"; mkdir -p "${work}"
    cd "${work}"

    n_want=$(wc -l < "${chunk_file}")
    echo "Chunk ${tag}: ${n_want} accessions -> ${work} (node-local jobfs)"

    # Dehydrated download then rehydrate is what NCBI and GTDB recommend
    # above roughly a thousand genomes; a per-accession loop gets rate
    # limited. --include takes gbff; "genbank" is rejected outright.
    if ! datasets download genome accession \
            --inputfile "${chunk_file}" \
            --include gbff \
            --dehydrated \
            --filename chunk.zip; then
        echo "ERROR: chunk ${tag}: datasets download failed." >&2
        cd "${PBS_O_WORKDIR}"; rm -rf "${work}"; return 1
    fi

    if ! unzip -o -q chunk.zip -d chunk_dehydrated; then
        echo "ERROR: chunk ${tag}: unzip failed." >&2
        cd "${PBS_O_WORKDIR}"; rm -rf "${work}"; return 1
    fi

    if ! datasets rehydrate --directory chunk_dehydrated; then
        echo "ERROR: chunk ${tag}: rehydrate failed." >&2
        cd "${PBS_O_WORKDIR}"; rm -rf "${work}"; return 1
    fi

    data_dir="chunk_dehydrated/ncbi_dataset/data"
    n_found=$(find "${data_dir}" -mindepth 2 -iname "*.gbff" | wc -l)
    echo "Chunk ${tag}: rehydrated ${n_found} of ${n_want}."

    if [ "${n_found}" -eq 0 ]; then
        echo "ERROR: chunk ${tag}: nothing rehydrated." >&2
        cd "${PBS_O_WORKDIR}"; rm -rf "${work}"; return 1
    fi

    # Record which accessions actually arrived, so a later stage can tell a
    # genuinely absent genome from one lost further down the pipeline.
    find "${data_dir}" -mindepth 2 -iname "*.gbff" -printf '%h\n' \
        | xargs -r -n1 basename | sort > "${manifest}"

    # A short rehydrate is not necessarily an error: NCBI permanently
    # withholds suppressed and withdrawn accessions, and this run hit 47 of
    # them, so failing the chunk would create a retry that can never
    # succeed. It must not be silent either. The .missing file is therefore
    # the authorised-absence list: 05_aggregate_results.py subtracts it from
    # the expected genome set, so an accession that is absent without being
    # listed here fails the coverage check instead of vanishing.
    if [ "${n_found}" -ne "${n_want}" ]; then
        echo "WARNING: chunk ${tag}: ${n_want} requested, ${n_found} rehydrated." >&2
        comm -23 <(sort "${chunk_file}") "${manifest}" \
            > "${ARCHIVE_DIR}/${tag}.missing" || true
        echo "         recorded $(wc -l < "${ARCHIVE_DIR}/${tag}.missing") \
absent accession(s) in ${tag}.missing" >&2
    else
        # A previous short download may have left one behind. A chunk that
        # is now complete must not keep an authorised-absence list, or those
        # genomes stay excused from the coverage check for good.
        rm -f "${ARCHIVE_DIR}/${tag}.missing"
    fi

    # Write to .partial and rename only on success, so an interrupted job
    # never leaves a truncated archive that 04 would read as complete.
    # zstd -3 measured about 3.5x on GenBank at roughly ten times gzip's
    # speed; copyq gives one core, so -T1.
    if ! tar -cf - -C "${data_dir}" . | zstd -3 -T1 -q -o "${archive}.partial"; then
        echo "ERROR: chunk ${tag}: packing failed." >&2
        rm -f "${archive}.partial"
        cd "${PBS_O_WORKDIR}"; rm -rf "${work}"; return 1
    fi
    mv "${archive}.partial" "${archive}"

    echo "Chunk ${tag} done: ${n_found} genomes, $(du -h "${archive}" | cut -f1)"

    # jobfs is shared across every chunk this subjob handles, so reclaim it
    # before the next one rather than accumulating all of them.
    cd "${PBS_O_WORKDIR}"
    rm -rf "${work}"
    return 0
}

echo "Subjob ${PBS_ARRAY_INDEX}: domain=${DOMAIN} stride=${STRIDE} total_chunks=${TOTAL_CHUNKS}"

n_done=0; n_skip=0; n_fail=0
for (( idx=PBS_ARRAY_INDEX; idx<TOTAL_CHUNKS; idx+=STRIDE )); do
    cid=$(printf "%03d" "${idx}")
    set +e
    do_chunk "${cid}"
    rc=$?
    set -e
    case "${rc}" in
        0) n_done=$((n_done + 1)) ;;
        2) n_skip=$((n_skip + 1)) ;;
        *) n_fail=$((n_fail + 1))
           echo "${DOMAIN}_${cid}" >> "${PBS_O_WORKDIR}/logs/download_failures_${DOMAIN}.txt" ;;
    esac
done

echo "Subjob ${PBS_ARRAY_INDEX} finished: ${n_done} downloaded, ${n_skip} skipped, ${n_fail} failed."

# Surface the authorised absences for this domain in the job log. They are
# consumed by 05_aggregate_results.py, but a number nobody ever reads is how
# a permanently omitted genome stops being noticed.
n_missing_files=$(find "${ARCHIVE_DIR}" -maxdepth 1 -name "${DOMAIN}_*.missing" | wc -l)
if [ "${n_missing_files}" -gt 0 ]; then
    n_missing_acc=$(cat "${ARCHIVE_DIR}/${DOMAIN}"_*.missing 2>/dev/null | wc -l)
    echo "Authorised absences so far for ${DOMAIN}: ${n_missing_acc} accession(s)" \
         "across ${n_missing_files} chunk(s) (${DOMAIN}_*.missing in ${ARCHIVE_DIR})."
    echo "These are subtracted from the expected set by 05_aggregate_results.py."
    echo "Confirm they are genuinely unavailable from NCBI rather than a"
    echo "transient rehydrate shortfall; re-running 02 for the chunk clears"
    echo "the file if they arrive."
fi

# Non-zero exit so a subjob that lost chunks is visible in qstat -x rather
# than being mistaken for a clean run.
[ "${n_fail}" -eq 0 ]
