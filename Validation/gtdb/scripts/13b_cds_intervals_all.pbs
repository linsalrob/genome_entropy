#!/bin/bash
#PBS -N ge_cds_iv_all
#PBS -q normal
#PBS -P ob80
#PBS -l ncpus=48
#PBS -l mem=190GB
#PBS -l jobfs=200GB
#PBS -l walltime=10:00:00
#PBS -l storage=gdata/ob80
#PBS -l wd
#PBS -j oe
#PBS -o logs/cds_intervals_all.log
#
# Deposited CDS coordinates for EVERY chunk of a domain.
#
# WHY THIS EXISTS SEPARATELY FROM 13_cds_intervals.pbs
#
# That script loops chunks serially, unpacking each to jobfs and giving
# cds_intervals.py all 24 cores for the one chunk. It was written for the
# handful of chunks a pilot needs, and at 760 chunks it cannot finish inside
# any reasonable walltime. This inverts the parallelism: one worker per
# chunk, cds_intervals.py single-threaded inside it. A GenBank chunk is
# ~1.6 GB unpacked, so 48 concurrent workers need ~79 GB of the 200 GB
# jobfs requested.
#
# 13_cds_intervals.pbs is left alone -- it is the right tool for a few
# named chunks, its output is interchangeable with this one's, and both
# write to the same directory with the same skip-if-present behaviour.
#
# INTEGRITY
#
# genome_cds_counts_<domain>.tsv already knows how many CDS features every
# genome has, counted independently with grep rather than Biopython. That
# makes a real cross-check possible per chunk:
#
#   - the number of distinct genomes in the output must equal the number of
#     genomes in that chunk carrying >=1 CDS feature;
#   - the row count must be >= the summed CDS count, since a compound or
#     origin-crossing location contributes one row per contiguous part and
#     nothing is filtered out.
#
# Under-production is the dangerous direction: a chunk that quietly lost
# genomes would make 10_missed_genes.py report their ORFs as intergenic,
# inflating the candidate pool. That is the defect this checks for.
#
# Submit as:
#   qsub -v DOMAIN=bac 13b_cds_intervals_all.pbs
#
# Resume is free: a chunk whose output already exists and passes the checks
# is skipped, so a walltime kill costs only the chunks in flight.

set -euo pipefail
cd "${PBS_O_WORKDIR}"

: "${DOMAIN:?Pass DOMAIN=bac or DOMAIN=arc via qsub -v}"
case "${DOMAIN}" in bac|arc) ;; *) echo "DOMAIN must be bac or arc" >&2; exit 2 ;; esac

GDATA_ROOT="${GDATA_ROOT:-/g/data/ob80/re3494/gtdb_entropy}"
GENBANK_DIR="${GENBANK_DIR:-${GDATA_ROOT}/genbank}"
ENV_PREFIX="${ENV_PREFIX:-/g/data/ob80/re3494/conda/genome_entropy}"
COUNTS="${COUNTS:-${GDATA_ROOT}/genome_cds_counts_${DOMAIN}.tsv}"
OUT_DIR="${GDATA_ROOT}/cds_intervals/${DOMAIN}"
mkdir -p "${OUT_DIR}"

if [ ! -s "${COUNTS}" ]; then
    echo "ERROR: ${COUNTS} not found. Run 12_genome_cds_counts.pbs first;" >&2
    echo "       without it this job cannot check its own output." >&2
    exit 1
fi

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "${ENV_PREFIX}"

# Per-chunk expectations, derived once: tag -> genomes_with_cds, total_cds.
awk -F'\t' 'NR>1 && $5=="True" { g[$3]++; c[$3]+=$4 }
            END { for (t in g) printf "%s\t%d\t%d\n", t, g[t], c[t] }' \
    "${COUNTS}" | sort > "${PBS_JOBFS}/expect.tsv"
echo "chunks with annotated genomes: $(wc -l < "${PBS_JOBFS}/expect.tsv")"

cat > "${PBS_JOBFS}/one_chunk.sh" <<EOF
#!/bin/bash
set -euo pipefail
tag="\$1"
archive="${GENBANK_DIR}/\${tag}.tar.zst"
out="${OUT_DIR}/\${tag}.tsv"

exp=\$(awk -F'\t' -v t="\${tag}" '\$1==t {print \$2"\t"\$3}' "${PBS_JOBFS}/expect.tsv")
exp_genomes=\$(echo "\${exp}" | cut -f1)
exp_cds=\$(echo "\${exp}" | cut -f2)
: "\${exp_genomes:=0}"
: "\${exp_cds:=0}"

check() {
    local f="\$1"
    local rows genomes
    rows=\$(( \$(wc -l < "\${f}") - 1 ))
    genomes=\$(tail -n +2 "\${f}" | cut -f1 | sort -u | wc -l)
    if [ "\${genomes}" -ne "\${exp_genomes}" ]; then
        echo "  \${tag}: \${genomes} genomes in output, expected \${exp_genomes}" >&2
        return 1
    fi
    if [ "\${rows}" -lt "\${exp_cds}" ]; then
        echo "  \${tag}: \${rows} CDS parts, fewer than the \${exp_cds} CDS features counted" >&2
        return 1
    fi
    return 0
}

if [ -s "\${out}" ]; then
    if check "\${out}"; then
        exit 0
    fi
    echo "REDO \${tag}: existing output failed its checks" >&2
fi

if [ ! -f "\${archive}" ]; then
    echo "ERROR \${tag}: \${archive} not found. 04_run_entropy.pbs removes" >&2
    echo "      consumed archives when DELETE_GENBANK_AFTER=1; re-download with 02." >&2
    exit 1
fi

work="${PBS_JOBFS}/w_\${tag}"
rm -rf "\${work}"; mkdir -p "\${work}"
trap 'rm -rf "\${work}"' EXIT

zstd -dq -c "\${archive}" | tar -xf - -C "\${work}" --wildcards '*.gbff' 2>/dev/null || {
    echo "ERROR \${tag}: could not extract GenBank members" >&2
    exit 1
}
find "\${work}" -mindepth 2 -iname '*.gbff' | sort > "\${work}/paths.txt"
if [ ! -s "\${work}/paths.txt" ]; then
    echo "ERROR \${tag}: no .gbff members in the archive" >&2
    exit 1
fi

# One core per chunk; the parallelism is across chunks here.
python3 "${PBS_O_WORKDIR}/cds_intervals.py" \\
    --paths "\${work}/paths.txt" \\
    --output "\${out}.partial" \\
    --workers 1

if ! check "\${out}.partial"; then
    echo "ERROR \${tag}: output failed its checks; not published" >&2
    rm -f "\${out}.partial"
    exit 1
fi
mv "\${out}.partial" "\${out}"
EOF
chmod +x "${PBS_JOBFS}/one_chunk.sh"

# The expected chunk set comes from the accession manifest, not from the
# archives present, for the reason 12_genome_cds_counts.pbs gives.
ls "${PBS_O_WORKDIR}/accessions/${DOMAIN}"_*.txt \
    > "${PBS_JOBFS}/expected.txt" 2>/dev/null || true
if [ ! -s "${PBS_JOBFS}/expected.txt" ]; then
    echo "ERROR: no accessions/${DOMAIN}_*.txt under ${PBS_O_WORKDIR}." >&2
    exit 1
fi
n_expected=$(wc -l < "${PBS_JOBFS}/expected.txt")
sed 's#.*/##; s#\.txt$##' "${PBS_JOBFS}/expected.txt" > "${PBS_JOBFS}/tags.txt"
echo "chunks expected : ${n_expected}"

xargs_rc=0
xargs -a "${PBS_JOBFS}/tags.txt" -n1 -P "${PBS_NCPUS:-48}" \
      "${PBS_JOBFS}/one_chunk.sh" || xargs_rc=$?

missing=0
while read -r tag; do
    if [ ! -s "${OUT_DIR}/${tag}.tsv" ]; then
        # A chunk with no annotated genomes legitimately has no CDS to write,
        # but cds_intervals.py still writes a header, so an absent file is a
        # failure either way.
        echo "ERROR: no CDS intervals for ${tag}" >&2
        missing=$((missing + 1))
    fi
done < "${PBS_JOBFS}/tags.txt"

if [ "${xargs_rc}" -ne 0 ] || [ "${missing}" -gt 0 ]; then
    echo "ERROR: ${missing} of ${n_expected} chunk(s) produced no CDS" >&2
    echo "       intervals (xargs exit ${xargs_rc}). 10_missed_genes.py would" >&2
    echo "       report their ORFs as intergenic, inflating the candidate" >&2
    echo "       pool, so this is not publishable. Chunks already complete" >&2
    echo "       are skipped on resubmission." >&2
    exit 1
fi

total=$(cat "${OUT_DIR}"/${DOMAIN}_*.tsv 2>/dev/null | grep -vc '^genome' || true)
echo ""
echo "=== ${OUT_DIR} ==="
echo "  chunk files   : $(ls "${OUT_DIR}"/${DOMAIN}_*.tsv 2>/dev/null | wc -l) of ${n_expected}"
echo "  CDS parts     : ${total}"
echo "  CDS features counted by 12_genome_cds_counts.pbs: $(awk -F'\t' 'NR>1 {s+=$4} END {print s}' "${COUNTS}")"
echo "  (parts >= features; a compound location is several parts)"
