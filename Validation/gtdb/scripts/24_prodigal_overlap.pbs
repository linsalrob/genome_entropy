#!/bin/bash
#PBS -N ge_prodigal
#PBS -q normal
#PBS -P ob80
#PBS -l ncpus=4
#PBS -l mem=128GB
#PBS -l walltime=03:00:00
#PBS -l storage=gdata/ob80
#PBS -l wd
#PBS -j oe
#
# 24_prodigal_overlap.py under the scheduler: the coordinate table is 30 M
# rows for archaea and will be ~620 M for the full set, which is not a login
# node's job to load.
#
#   qsub -v COORDS=<...>.tsv.gz,CONTEXT=<...>/context,OUT=<...>.txt \
#        24_prodigal_overlap.pbs

set -euo pipefail
cd "${PBS_O_WORKDIR}"

: "${COORDS:?Pass COORDS=<prodigal coords tsv.gz> via qsub -v}"
: "${CONTEXT:?Pass CONTEXT=<context dir> via qsub -v}"
: "${OUT:?Pass OUT=<report path> via qsub -v}"

ENV_PREFIX="${ENV_PREFIX:-/g/data/ob80/re3494/conda/genome_entropy}"
# shellcheck disable=SC1091
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "${ENV_PREFIX}"

python3 -u 24_prodigal_overlap.py \
    --coords "${COORDS}" --context "${CONTEXT}" --out "${OUT}"
