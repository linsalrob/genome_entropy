#!/bin/bash
#PBS -N gtdb_cds_counts
#PBS -q normal
#PBS -P ob80
#PBS -l ncpus=24
#PBS -l mem=96GB
#PBS -l jobfs=200GB
#PBS -l walltime=04:00:00
#PBS -l storage=gdata/ob80
#PBS -l wd
#PBS -j oe
#PBS -o logs/cds_counts_^array_index^.log
#
# Count CDS features per genome directly from the downloaded GenBank files.
#
# WHY THIS EXISTS
#
# `in_genbank` is set only when a called ORF passes the coordinate, frame,
# and translation match in genome_entropy's GenBank matcher. A genome with
# real CDS annotation whose features all fail that strict match -- partial
# CDSs, compound or origin-crossing features, CDSs below the ORF length
# threshold, translations that disagree -- has every ORF marked False and is
# indistinguishable, in the entropy TSVs alone, from a genome that was never
# annotated.
#
# 10_missed_genes.py and 11_genome_annotation_status.pbs both used
# `any(in_genbank)` as a proxy for "this genome has annotation". That proxy
# cannot separate "annotation declined this ORF" from "the matcher declined
# this annotation", so it can only over-report unannotated genomes, which
# inflates the share of high-3Di ORFs attributed to never-annotated genomes.
#
# This job reads the GenBank records themselves, which is the only
# authoritative answer. Counting feature-table CDS lines needs no parser: in
# the GenBank flat-file format a feature key sits in columns 6-20 of its
# first line, so `^     CDS  ` matches exactly the CDS feature starts and
# cannot match a qualifier value or sequence line.
#
# Output: one row per genome
#   genome  domain  chunk  n_cds  has_annotation
#
# Submit as:
#   qsub -v DOMAIN=bac 12_genome_cds_counts.pbs

set -euo pipefail
cd "${PBS_O_WORKDIR}"

: "${DOMAIN:?Pass DOMAIN=bac or DOMAIN=arc via qsub -v}"
case "${DOMAIN}" in bac|arc) ;; *) echo "DOMAIN must be bac or arc" >&2; exit 2 ;; esac

GDATA_ROOT="${GDATA_ROOT:-/g/data/ob80/re3494/gtdb_entropy}"
GENBANK_DIR="${GENBANK_DIR:-${GDATA_ROOT}/genbank}"
CACHE="${GDATA_ROOT}/cds_counts_cache/${DOMAIN}"
OUT="${GDATA_ROOT}/genome_cds_counts_${DOMAIN}.tsv"
mkdir -p "${CACHE}"

# One chunk archive: stream it, count CDS feature lines per accession
# directory, never unpack to disk. Cached per chunk so a resubmission after
# a walltime kill picks up where it stopped.
cat > "${PBS_JOBFS}/one_chunk.sh" <<'EOS'
#!/bin/bash
set -euo pipefail
archive="$1"; cache="$2"; domain="$3"
tag="$(basename "${archive}" .tar.zst)"
out="${cache}/${tag}.tsv"
[ -s "${out}" ] && exit 0

work="${PBS_JOBFS}/cds_${tag}"
rm -rf "${work}"; mkdir -p "${work}"

# GenBank files are the only members worth reading, and the accession is the
# directory holding each one (NCBI names every file genomic.gbff).
# Non-zero, not a warning: this table is the authoritative annotation
# answer, and a chunk that produced no cache file would drop every genome
# in it from the published table without changing the exit status.
zstd -dq -c "${archive}" | tar -xf - -C "${work}" --wildcards '*.gbff' 2>/dev/null || {
    echo "ERROR: ${tag}: could not extract GenBank members" >&2
    rm -rf "${work}"; exit 1
}

find "${work}" -mindepth 2 -iname '*.gbff' -print0 \
  | while IFS= read -r -d '' f; do
        genome="$(basename "$(dirname "${f}")")"
        # A feature key occupies columns 6-20 of its first line, so this
        # anchors on CDS feature starts only.
        n=$(grep -c '^     CDS  ' "${f}" || true)
        printf '%s\t%s\t%s\t%d\t%s\n' \
               "${genome}" "${domain}" "${tag}" "${n}" \
               "$( [ "${n}" -gt 0 ] && echo True || echo False )"
    done > "${out}.tmp"

mv "${out}.tmp" "${out}"
rm -rf "${work}"
EOS
chmod +x "${PBS_JOBFS}/one_chunk.sh"

ls "${GENBANK_DIR}"/${DOMAIN}_*.tar.zst > "${PBS_JOBFS}/archives.txt" 2>/dev/null || true
n_arch=$(wc -l < "${PBS_JOBFS}/archives.txt")
echo "archives present : ${n_arch}"
echo "already cached   : $(ls "${CACHE}"/*.tsv 2>/dev/null | wc -l)"
if [ "${n_arch}" -eq 0 ]; then
    echo "No ${DOMAIN}_*.tar.zst under ${GENBANK_DIR}." >&2
    echo "04_run_entropy.pbs deletes consumed archives when" >&2
    echo "DELETE_GENBANK_AFTER=1; re-download with 02 if so." >&2
    exit 1
fi

xargs_rc=0
xargs -a "${PBS_JOBFS}/archives.txt" -n1 -P "${PBS_NCPUS:-24}" \
      -I{} "${PBS_JOBFS}/one_chunk.sh" {} "${CACHE}" "${DOMAIN}" || xargs_rc=$?

# Belt and braces: xargs reporting success is not proof that every archive
# produced a cache entry, and a missing entry silently removes a whole
# chunk's genomes from a table other scripts treat as authoritative.
missing=0
while read -r archive; do
    tag="$(basename "${archive}" .tar.zst)"
    if [ ! -s "${CACHE}/${tag}.tsv" ]; then
        echo "ERROR: no CDS counts cached for ${tag}" >&2
        missing=$((missing + 1))
    fi
done < "${PBS_JOBFS}/archives.txt"

if [ "${xargs_rc}" -ne 0 ] || [ "${missing}" -gt 0 ]; then
    echo "ERROR: ${missing} of ${n_arch} chunk(s) produced no CDS counts;" >&2
    echo "       refusing to publish a table missing their genomes." >&2
    echo "       Fix or re-download those archives and rerun; chunks already" >&2
    echo "       cached are skipped, so only the failures are redone." >&2
    exit 1
fi

{
    printf 'genome\tdomain\tchunk\tn_cds\thas_annotation\n'
    cat "${CACHE}"/*.tsv | sort -k1,1
} > "${OUT}.partial"
mv "${OUT}.partial" "${OUT}"

echo ""
echo "=== ${OUT} ==="
awk -F'\t' 'NR>1 {
    g++; cds += $4
    if ($5 == "True") a++; else u++
} END {
    printf "  genomes              : %d\n", g
    printf "    with CDS features  : %d (%.1f%%)\n", a, 100*a/g
    printf "    with none          : %d (%.1f%%)\n", u, 100*u/g
    printf "  CDS features total   : %d\n", cds
    printf "\n  This is the authoritative annotation-presence answer.\n"
    printf "  Compare against genome_annotation_status_*.tsv: genomes marked\n"
    printf "  annotated here but unannotated there are ones whose CDSs the\n"
    printf "  ORF matcher rejected, not genomes lacking annotation.\n"
}' "${OUT}"
