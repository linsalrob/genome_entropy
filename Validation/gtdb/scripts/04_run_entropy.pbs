#!/bin/bash
#PBS -N gtdb_entropy_3di
#PBS -q gpuvolta
#PBS -P ob80
#PBS -l ngpus=1
#PBS -l ncpus=12
#PBS -l mem=90GB
#PBS -l jobfs=200GB
#PBS -l walltime=10:00:00
#PBS -l storage=gdata/ob80
#PBS -l wd
#PBS -r y
#PBS -j oe
#PBS -o logs/entropy3di_^array_index^.log
#
# Produces 3Di + 12-state entropy (and their mutual information) using the
# dual-head ModernProst model. Confirmed against genome_entropy 0.2.0:
# `run` accepts --model/-m, --genbank/-g and --output/-o, and emits schema
# 2.2.0 with entropy fields dna_entropy, protein_entropy, three_di_entropy,
# twelve_state_entropy and three_di_twelve_state_mutual_information.
#
# INODES AND BYTES BOTH MATTER HERE.
#
# Measured on Gadi: entropy JSON runs 2.3-4.9x the size of its GenBank
# input, so 200k genomes is on the order of 3 TB uncompressed and 200k
# inodes. gdata/ob80 has roughly 520k inodes free in total. So, exactly as
# in 02, nothing per-genome is written to /g/data: the chunk archive is
# expanded onto node-local $PBS_JOBFS, results are written there, and only
# two files per chunk land on /g/data:
#
#   entropy_3di_results/chunk_NNN.tar.zst   all per-genome JSON, zstd -3
#   entropy_3di_results/chunk_NNN.tsv.gz    per-ORF entropy rows only
#
# The TSV exists so downstream analysis never has to unpack the JSON at
# all; the JSON archive is there when you need sequences or encodings.
# zstd -3 measured about 3.4x on this output.
#
# BEFORE SUBMITTING:
#   1. 02_download_genomes.pbs must have produced genbank/chunk_NNN.tar.zst
#      for the matching indices.
#   2. The conda env, get_orfs, and the HF cache must exist (see
#      03_install_genome_entropy.sh and 03b_download_model.sh).
#   3. mkdir -p logs
#
# DOMAIN and the array range are passed at submission, keeping bacteria and
# archaea in separate namespaces end to end:
#
#   qsub -v DOMAIN=bac -J 0-474 04_run_entropy.pbs

set -euo pipefail
cd "${PBS_O_WORKDIR}"

GDATA_ROOT="/g/data/ob80/re3494/gtdb_entropy"
GENBANK_DIR="${GDATA_ROOT}/genbank"
ENTROPY_OUT="${GDATA_ROOT}/entropy_3di_results"
MODEL="gbouras13/modernprost-50M"

# Per-batch token budget in amino acids.
#
# Measured, do not raise this. On bacterial genomes over two rounds
# (logs/calibration_bac_results.tsv) the default 10000 was fastest at 119.5
# s/genome; 25000 was within noise at 120.3, 50000 cost 3.6% and 100000
# cost 9.1%. An earlier single-genome archaeal sweep went further: 800000
# was 14% slower than the default, and 400000 and 800000 returned identical
# peak memory, meaning the budget already exceeded a whole genome's protein
# content. Wider batches mix sequence lengths and pad to the longest, so
# filling GPU memory buys nothing here.
ENCODING_SIZE="${ENCODING_SIZE:-10000}"

# Genomes encoded concurrently on the one GPU. One at a time leaves the
# device far short of saturated -- 12-48% utilisation at 1.5-2.1 GB of 32
# GB -- while using a single core of the 12 that gpuvolta bills per GPU.
# See logs/calibration_par_results.tsv for the measured throughput.
PARALLEL="${PARALLEL:-4}"

ENV_PREFIX="${ENV_PREFIX:-/g/data/ob80/re3494/conda/genome_entropy}"

# Set to 1 to delete a chunk's GenBank archive once its entropy archive has
# been written successfully. The GenBank files can always be re-downloaded
# from NCBI, so this is purely a storage/inode policy choice; it costs one
# unlink per chunk and saves a few hundred GB across the full run.
DELETE_GENBANK_AFTER="${DELETE_GENBANK_AFTER:-0}"

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "${ENV_PREFIX}"

export GET_ORFS_PATH="${GET_ORFS_PATH:-/g/data/ob80/re3494/Projects/genome_entropy/get_orfs/bin/get_orfs}"

# GPU nodes have no route to Hugging Face. Fail immediately on a cache miss
# rather than hanging on a connection that cannot succeed.
export HF_HOME="${HF_HOME:-${GDATA_ROOT}/hf_cache}"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TORCH_DISABLE_DYNAMO=1

: "${DOMAIN:?Pass DOMAIN=bac or DOMAIN=arc via qsub -v}"
case "${DOMAIN}" in bac|arc) ;; *) echo "DOMAIN must be bac or arc" >&2; exit 2 ;; esac

# This server caps arrays at 10 subjobs (max_array_size = 10), and a chunk
# takes hours, so a strided subjob cannot cover 760 chunks inside a
# walltime the way the download job can. Instead each 10-wide array covers
# a block of 10 chunks, offset by CHUNK_START:
#
#   qsub -v DOMAIN=bac,CHUNK_START=10 -r y -J 0-9 04_run_entropy.pbs
#
# PBS also rejects a one-element array (-J 0-0), so a single chunk can be
# run standalone with -v CHUNK=N for validating or re-running one index.
if [ -n "${PBS_ARRAY_INDEX:-}" ]; then
    CHUNK_INDEX=$(( ${CHUNK_START:-0} + PBS_ARRAY_INDEX ))
else
    CHUNK_INDEX="${CHUNK:-}"
fi
: "${CHUNK_INDEX:?Pass CHUNK=<n> via qsub -v, or submit as an array}"
CHUNK_ID=$(printf "%03d" "${CHUNK_INDEX}")
TAG="${DOMAIN}_${CHUNK_ID}"
ARCHIVE="${GENBANK_DIR}/${TAG}.tar.zst"
# Results are written under a per-domain directory so bacteria and archaea
# never share an output namespace and can be aggregated independently.
ENTROPY_OUT="${ENTROPY_OUT}/${DOMAIN}"
OUT_TAR="${ENTROPY_OUT}/${TAG}.tar.zst"
OUT_TSV="${ENTROPY_OUT}/${TAG}.tsv.gz"

FAILURES_FILE="${ENTROPY_OUT}/${TAG}.failures"

# A chunk that published with failures is not finished. Its outputs are on
# /g/data so the encoded genomes are not lost, but the genomes named in
# .failures are still missing from both, and skipping on the presence of
# OUT_TAR alone meant a resubmission exited 0 without retrying them -- so
# the GenBank archive kept back for exactly that recovery was never used.
RETRY_PUBLISHED=0
if [ -f "${OUT_TAR}" ]; then
    if [ -s "${FAILURES_FILE}" ]; then
        echo "Chunk ${TAG}: published, but ${TAG}.failures lists"
        echo "  $(wc -l < "${FAILURES_FILE}") genome(s) still missing — retrying those."
        RETRY_PUBLISHED=1
    else
        echo "Chunk ${TAG}: ${OUT_TAR} already exists — nothing to do."
        exit 0
    fi
fi

# Checked after the completed-chunk exit, not before: DELETE_GENBANK_AFTER=1
# removes the archive of a chunk that finished cleanly, and resubmitting the
# block that contains it must still report that index as done rather than as
# a missing input. A retry does need the archive, and reaches here.
if [ ! -f "${ARCHIVE}" ]; then
    echo "ERROR: ${ARCHIVE} not found — did the matching download chunk" >&2
    echo "       finish, or was it removed by DELETE_GENBANK_AFTER=1?" >&2
    if [ "${RETRY_PUBLISHED}" = "1" ]; then
        echo "       Retrying ${TAG} needs it back: re-download with 02." >&2
    fi
    exit 1
fi

mkdir -p "${ENTROPY_OUT}"

WORK="${PBS_JOBFS}/${TAG}"
IN_DIR="${WORK}/genbank"
OUT_DIR="${WORK}/json"
# Encoding writes here and is moved into OUT_DIR only on success, so
# OUT_DIR never holds a half-written JSON for the signal handler to pack or
# for a resumed run to mistake for a finished genome.
TMP_DIR="${WORK}/incomplete"
mkdir -p "${IN_DIR}" "${OUT_DIR}" "${TMP_DIR}"

# PBS sends SIGTERM before killing a job at its walltime. Flush whatever
# has been encoded so far to /g/data under a .partial name rather than
# losing an entire chunk's GPU time; a resubmitted index can then be
# reconciled against it instead of starting from zero.
flush_partial () {
    local n
    # Stop dispatching new genomes. Encoders already running write into
    # TMP_DIR and only move into OUT_DIR on success, so whatever they are
    # midway through cannot end up in the archive.
    [ -n "${XARGS_PID:-}" ] && kill "${XARGS_PID}" 2>/dev/null
    n=$(find "${OUT_DIR}" -name "*.json" | wc -l)
    if [ "${n}" -gt 0 ]; then
        echo "Flushing ${n} completed genomes to ${OUT_TAR}.partial" >&2
        # -f because a resumed run started from an earlier .partial and
        # zstd refuses to overwrite an existing -o target.
        tar -cf - -C "${OUT_DIR}" . | zstd -3 -T4 -q -f -o "${OUT_TAR}.partial" || true
    fi
    # Exit rather than fall through to the packing step. Continuing would
    # publish OUT_TAR and OUT_TSV for a chunk that only encoded part of its
    # genomes, and the "output already exists" check at the top means no
    # resubmission would ever revisit it.
    echo "Chunk ${TAG}: terminated at walltime; resubmit this index to resume." >&2
    exit 143
}
trap 'flush_partial' TERM

echo "=== node ==="
hostname
echo "encoding-size: ${ENCODING_SIZE}   parallel: ${PARALLEL}"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-unset}"

echo "=== unpacking ${ARCHIVE} to node-local jobfs ==="
zstd -dq -c "${ARCHIVE}" | tar -xf - -C "${IN_DIR}"
find "${IN_DIR}" -mindepth 2 -iname "*.gbff" | sort > "${WORK}/gbff_paths.txt"
total=$(wc -l < "${WORK}/gbff_paths.txt")
echo "Chunk ${TAG}: ${total} genomes in this chunk"

# A previous attempt that hit walltime flushed its completed genomes to
# OUT_TAR.partial. Restore them before building the worklist, so this run
# re-encodes only what is missing; encode_one.sh already skips a genome
# whose JSON is present. Without this the flush preserved nothing and the
# chunk restarted from zero, which is the opposite of what it promises.
resumed=0

# Retrying a published chunk: unpack what succeeded, then drop the JSON of
# every genome named in .failures. Encode failures have no JSON to drop;
# genomes whose JSON was unreadable do, and leaving it would make
# encode_one.sh skip them and the extraction fail again identically.
if [ "${RETRY_PUBLISHED}" = "1" ]; then
    echo "=== restoring ${TAG}.tar.zst before retrying its failures ==="
    zstd -dq -c "${OUT_TAR}" | tar -xf - -C "${OUT_DIR}"
    while read -r label; do
        [ -n "${label}" ] || continue
        rm -f "${OUT_DIR}/${label}.json"
    done < "${FAILURES_FILE}"
    resumed=$(find "${OUT_DIR}" -name '*.json' | wc -l)
    echo "Chunk ${TAG}: kept ${resumed} genomes, retrying the rest."
fi

if [ -f "${OUT_TAR}.partial" ]; then
    echo "=== resuming from $(basename "${OUT_TAR}.partial") ==="
    if zstd -dq -c "${OUT_TAR}.partial" | tar -xf - -C "${OUT_DIR}"; then
        resumed=$(find "${OUT_DIR}" -name '*.json' | wc -l)
        echo "Chunk ${TAG}: recovered ${resumed} genomes."
    else
        echo "WARNING: ${OUT_TAR}.partial is unreadable; re-encoding the chunk." >&2
        rm -rf "${OUT_DIR}"; mkdir -p "${OUT_DIR}"
    fi
fi

# NCBI datasets names every GenBank file "genomic.gbff" and puts the
# accession in the parent directory:
#     ncbi_dataset/data/GCA_030638685.1/genomic.gbff
# Naming outputs from the basename would give every genome in a chunk the
# same output file, and the resume check would then skip the rest of the
# chunk after the first genome. Derive the label from the accession
# directory instead.
genome_label () {
    local path="$1" base
    base="$(basename "${path}")"
    base="${base%.gz}"
    if [ "${base}" = "genomic.gbff" ]; then
        basename "$(dirname "${path}")"
    else
        echo "${base%.gbff}"
    fi
}

# One genome. Written to a file because xargs runs it in its own shell, so
# it cannot rely on anything defined above.
cat > "${WORK}/encode_one.sh" <<EOF
#!/bin/bash
gbff="\$1"
base="\$(basename "\${gbff}")"; base="\${base%.gz}"
if [ "\${base}" = "genomic.gbff" ]; then
    label="\$(basename "\$(dirname "\${gbff}")")"
else
    label="\${base%.gbff}"
fi
out="${OUT_DIR}/\${label}.json"
tmp="${TMP_DIR}/\${label}.json"
[ -f "\${out}" ] && exit 0
if genome_entropy run --genbank "\${gbff}" --model "${MODEL}" \
        --encoding-size ${ENCODING_SIZE} \
        --output "\${tmp}" >> "${WORK}/logs/\${label}.log" 2>&1; then
    # Same filesystem, so this is atomic: only a complete JSON ever appears
    # in OUT_DIR, which is what the flush packs and the resume trusts.
    mv "\${tmp}" "\${out}"
    exit 0
fi
rm -f "\${tmp}"
echo "\${label}" >> "${WORK}/failures.txt"
echo "FAILED: \${label}" >&2
# Keep the reason. PBS -o files collide when several arrays share an array
# index, so a failure that is only explained in the job log is a failure
# whose explanation gets overwritten. Copy the tail next to the results.
{
  echo "=== \${label} ==="
  tail -25 "${WORK}/logs/\${label}.log"
  echo
} >> "${ENTROPY_OUT}/${TAG}.failure_logs"
exit 0   # keep xargs going; failures are counted from the file
EOF
chmod +x "${WORK}/encode_one.sh"
mkdir -p "${WORK}/logs"
: > "${WORK}/failures.txt"

echo "Encoding ${total} genomes, ${PARALLEL} at a time ..."
# Backgrounded, then waited on. Bash defers a trap while it is blocked in a
# foreground command, so with a plain foreground xargs the TERM handler
# would not run until encoding finished -- i.e. never, for the walltime kill
# it exists to handle. Blocking in `wait` instead lets it fire immediately.
xargs -a "${WORK}/gbff_paths.txt" -n1 -P "${PARALLEL}" "${WORK}/encode_one.sh" &
XARGS_PID=$!
wait "${XARGS_PID}" || true
XARGS_PID=""

done_count=$(find "${OUT_DIR}" -name "*.json" | wc -l)
fail_count=$(sort -u "${WORK}/failures.txt" | tee "${WORK}/failures_uniq.txt" | wc -l)
mv "${WORK}/failures_uniq.txt" "${WORK}/failures.txt"

echo "Chunk ${TAG}: ${done_count} complete (${resumed} restored, \
$((done_count - resumed)) encoded here), ${fail_count} failed."

if [ "${done_count}" -eq 0 ]; then
    echo "ERROR: nothing encoded; not writing an archive." >&2
    exit 1
fi

# Per-ORF entropy rows, so downstream work never needs the JSON archive.
echo "=== extracting entropy rows ==="
# A genome whose JSON cannot be read back exits this non-zero. Downstream
# aggregation reads only the TSV, so such a genome would otherwise vanish
# from the experiment while the chunk reported clean -- and, with
# DELETE_GENBANK_AFTER=1, its GenBank archive would be deleted too. Count it
# against the chunk exactly like an encoding failure.
extract_rc=0
python3 "${PBS_O_WORKDIR}/extract_entropy_rows.py" \
    --input-dir "${OUT_DIR}" \
    --chunk "${CHUNK_ID}" --domain "${DOMAIN}" \
    --output "${WORK}/${TAG}.tsv" \
    --failures "${WORK}/unparseable.txt" || extract_rc=$?

if [ "${extract_rc}" -ne 0 ]; then
    if [ -s "${WORK}/unparseable.txt" ]; then
        n_unparseable=$(wc -l < "${WORK}/unparseable.txt")
        echo "ERROR: ${n_unparseable} genome(s) produced unreadable JSON; the" >&2
        echo "       TSV for chunk ${TAG} is incomplete." >&2
        cat "${WORK}/unparseable.txt" >> "${WORK}/failures.txt"
        fail_count=$((fail_count + n_unparseable))
    else
        echo "ERROR: entropy extraction failed for chunk ${TAG}." >&2
        exit 1
    fi
fi

# Still published: these hold real encoded genomes, and discarding them
# would waste the GPU time. The non-zero exit at the end and the .failures
# file are what stop the chunk reading as clean, and the raised fail_count
# is what stops the GenBank archive being deleted below.
gzip -c "${WORK}/${TAG}.tsv" > "${OUT_TSV}.partial"
mv "${OUT_TSV}.partial" "${OUT_TSV}"

# Single archive of all per-genome JSON. Write to .partial and rename only
# on success so a truncated archive is never mistaken for a finished chunk.
echo "=== packing JSON archive ==="
trap - TERM
tar -cf - -C "${OUT_DIR}" . | zstd -3 -T4 -q -f -o "${OUT_TAR}.partial"
mv "${OUT_TAR}.partial" "${OUT_TAR}"

if [ "${fail_count}" -gt 0 ]; then
    cp "${WORK}/failures.txt" "${FAILURES_FILE}"
else
    # Clear a marker left by an earlier attempt, or the next submission
    # would keep retrying a chunk that is now complete.
    rm -f "${FAILURES_FILE}"
fi

echo "Chunk ${TAG} complete."
echo "  json archive: ${OUT_TAR} ($(du -h "${OUT_TAR}" | cut -f1))"
echo "  entropy rows: ${OUT_TSV} ($(du -h "${OUT_TSV}" | cut -f1))"
echo "  /g/data inodes used by this chunk: 2"

if [ "${DELETE_GENBANK_AFTER}" = "1" ] && [ "${fail_count}" -eq 0 ]; then
    echo "Removing consumed GenBank archive ${ARCHIVE} (re-downloadable via 02)."
    rm -f "${ARCHIVE}"
fi

# Non-zero exit so a partially failed index is visible in qstat -x rather
# than being mistaken for a clean run.
[ "${fail_count}" -eq 0 ]
